+func _capture_state(label: String) -> void:
+	print("SHOWCASE_CAPTURE_STATE ", JSON.stringify({"label": label,
+		"os_focused": DisplayServer.window_is_focused(), "window_focused": root.has_focus(),
+		"focused": _display.get("_focused"), "suspended": _display.suspended,
+		"intro_running": _display.get("_intro").running, "dragging": _display.dragging,
+		"hovered": _display.hovered, "state": _display.state, "angle": _display.angle,
+		"pointer": str(_display.get("_pointer")), "display_size": str(_display.size)}))
+
+
+func _capture_ready(settled: bool) -> bool:
+	var deadline := Time.get_ticks_msec() + 6000
+	var stable := 0
+	while stable < 4 and Time.get_ticks_msec() < deadline:
+		await RenderingServer.frame_post_draw
+		var valid: bool = DisplayServer.window_is_focused() and root.has_focus() \
+			and _display.get("_focused") and not _display.suspended and not _display.dragging
+		if settled:
+			valid = valid and not _display.get("_intro").running
+			for mesh in _display.get("_pivot").find_children("*", "MeshInstance3D", true, false):
+				valid = valid and mesh.transparency <= 0.001
+		stable = stable + 1 if valid else 0
+		await process_frame
+	_capture_state("ready_settled" if settled else "ready_initial")
+	_check(stable == 4, "录像前置条件：真实焦点、无阻断、连续四帧稳定 settled=%s" % settled)
+	return stable == 4
 
 

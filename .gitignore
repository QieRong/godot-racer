# ── Godot 4 引擎产物 ─────────────────────────────────────
# 导入缓存与着色器缓存：体积大、可自动重建，不入库
.godot/
dist/

# ── 运行日志 ─────────────────────────────────────────────
godot-logs/
*.log

# ── 操作系统 / 编辑器杂物 ────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# 截图产物：刻意保留的画面记录统一放在 screenshots/（已入库）。
# --shot 钩子默认输出到 godot-logs/（已忽略），临时产物不入库。

# ── AI 协作工具的工作目录（不是项目产物）────────────────────
# .workbuddy/ 存 agent 的工作记忆、临时计划等本地状态，不入库
.workbuddy/

# ── 第三方 Godot 插件（不入库，用 AssetLib 或脚本重装）──────
# godot-mcp 的编辑器插件是外部依赖，和 .godot/ 一样属于「可重建」的本地产物。
godot-racer/addons/

# ── 密钥 / 本地配置（必须排除，绝不能让凭据进仓库）──────────
# 任何 *.local.cfg / .env 都只留在本机，不入库
*.local.cfg
.env
.env.*

# 临时文件（例如写提交信息用的 .tmp）：绝不入库
*.tmp

# --shot 钩子的默认输出（临时产物；正式画面记录放 screenshots/）
godot-shot*.png

# ── Python 字节码缓存 ────────────────────────────────────
# godot-logs/ 下的探针脚本会 import 02-Blender建模/*.py（复用闸门函数、
# 不复制公式），Python 据此生成 __pycache__ —— 可重建的本地产物，不入库。
__pycache__/
*.pyc

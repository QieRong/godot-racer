[internationalization]

locale/translations=PackedStringArray("res://localization/zh_CN.po", "res://localization/zh_TW.po", "res://localization/en.po", "res://localization/ru.po", "res://localization/ja.po", "res://localization/ko.po")
locale/fallback="zh_CN"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="vehicle"
3d_physics/layer_3="checkpoint"

[phantom_camera]

updater/updater_mode=0.0

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

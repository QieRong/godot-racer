# OpenRouter 配置模板（复制成 openrouter.local.cfg 再填自己的值）
#
# 为什么用"复制模板"而不是直接把密钥写进去：
#   .gitignore 里排除了 openrouter.local.cfg，所以**只有你的这份会被忽略**，
#   模板可以安全入库，别人 clone 后知道自己该建哪个文件。
#
# 优先级：环境变量 > 本文件 > user://openrouter.cfg
#   （想更安全就一个字段都别填，改用环境变量：
#      $env:OPENROUTER_API_KEY = "sk-or-v1-..."
#      $env:OPENROUTER_PROXY   = "http://127.0.0.1:7897"）
#
# proxy 是"智能分流"的关键：只给这一个测试模块挂代理，
# 游戏本身和 DSH 都不走它 —— 所以开代理不会影响你正在用的工具链。

api_key=sk-or-v1-在此填入你自己的密钥
proxy=http://127.0.0.1:7897
model=nvidia/llama-3.1-nemotron-70b-instruct

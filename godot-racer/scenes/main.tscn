[node name="Track" parent="." instance=ExtResource("1_track")]

[node name="RaceCar" parent="." instance=ExtResource("2_car")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 320, 0.55, 0)
; 出生在起终点线上（赛道生成器报告的 StartFinish 位置 (320, 0, 0)），
; 朝向 (0,0,1) = 椭圆在该点的切线方向。
; 注意：换赛道形状后必须同步改这两个值，否则车会出生在草地上 ——
; 我踩过这个坑：出生点沿用了旧赛道的 (-75,-55)，结果全程在草地里开。

[node name="ChaseCamera" type="Camera3D" parent="." node_paths=PackedStringArray("target")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 3.2, -20)
current = true
fov = 70.0
script = ExtResource("3_camera")
target = NodePath("../RaceCar")

; ============ 右上角实时小地图 ============
; Minimap 及其 SubViewport 单独一套世界：里面只有"路面环 + 起终点 + 检查点 + 车点"，
; 全部由 scripts/minimap.gd 从赛道中心线现搭（见该文件顶部的取舍说明）。
; 注意节点顺序：Minimap 必须排在 HUD **前面**，否则 HUD 的 _ready 先跑，
; 会在 Minimap 还没搭出 CarMarker 时就去找它（实测 warning: 找不到 CarMarker）。
[node name="Minimap" type="Node3D" parent="."]
script = ExtResource("6_minimap")

[node name="SubViewport" type="SubViewport" parent="Minimap"]
handle_input_locally = false
size = Vector2i(360, 360)
render_target_update_mode = 4

; 正交俯视：相机固定在赛道中心上方，包住整条赛道；不跟随车。
; cull_mask 由 scripts/minimap.gd 设为"只渲染地图层(第17层)"。
[node name="TopCam" type="Camera3D" parent="Minimap/SubViewport"]
transform = Transform3D(1, 0, 0, 0, -4.37114e-08, 1, 0, -1, -4.37114e-08, 0, 320, 0)
projection = 1
size = 760.0
near = 1.0
far = 2000.0

[node name="HUD" type="CanvasLayer" parent="." node_paths=PackedStringArray("car", "minimap")]
script = ExtResource("4_hud")
car = NodePath("../RaceCar")
minimap = NodePath("../Minimap")


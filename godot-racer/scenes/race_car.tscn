; ---------------------------------------------------------------- 车轮
; 重要：VehicleWheel3D 的 position 是"悬挂硬点/塔顶"，不是轮心！
; 引擎源码 _ray_cast(): 射线从 hardPoint 向上抬一个 wheel_radius 再向下打
;   rest_length + wheel_radius。
; 因此平地静止时，硬点高度 = wheel_radius + wheel_rest_length。
; 之前我把轮心坐标直接填进硬点（y = 轮半径），等于让悬挂一开始就压到底，
; 车会沉降约 rest_length 并因此抖动、加速异常。
; 数值来源：模型实测 前轮半径 0.34 / 后轮 0.50，轮距 ±0.68，轴距 2.10
;   前轮硬点 y = 0.34 + 0.15 = 0.49
;   后轮硬点 y = 0.50 + 0.15 = 0.65

[node name="WheelFrontLeft" type="VehicleWheel3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.68, 0.49, -1.05)
use_as_steering = true
use_as_traction = false
wheel_radius = 0.34
wheel_rest_length = 0.15
wheel_friction_slip = 3.0
wheel_roll_influence = 0.06
suspension_stiffness = 70.0
suspension_travel = 0.15
suspension_max_force = 9000.0
damping_compression = 0.5
damping_relaxation = 0.7


 ## ② 逐关验收：读本关的 layout 真串，做几何体检。
 func _check_layout_level(mod: GDScript) -> void:
+	# 迁移前是 get_node_or_null("Track")；SPLIT-CHECKS-LAYOUT-001 改为 setup() 注入
+	# （模块不 get_node，§2.4），null 检查原样保留。
 	var track := _track
 	if track == null:
 		_layout_geom_fail += 1

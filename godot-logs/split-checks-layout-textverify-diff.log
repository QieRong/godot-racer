-	if mod == null or not mod.has_method("wrong_way_state"):
-		printerr("[自检] reverse 验收 ✘ track_layout.gd 不可用或缺少 wrong_way_state（实现未落地）")
-		printerr("[自检]   reverse 用例跑了 0/%d 条，绿 0 条" % REVERSE_CASES)
